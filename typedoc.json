{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": ["packages/zero-auth/src/index.ts"],
  "tsconfig": "packages/zero-auth/tsconfig.json",
  "plugin": ["typedoc-plugin-markdown"],
  "outputs": [{ "name": "markdown", "path": "docs/api" }],
  "entryFileName": "index",
  "name": "zero-auth API Documentation",
  "excludePrivate": true,
  "excludeProtected": false,
  "excludeInternal": true,
  "cleanOutputDir": true,
  "includeVersion": true,
  "readme": "none",
  "githubPages": false
}
